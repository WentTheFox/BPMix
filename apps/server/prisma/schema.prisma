// Library-scoped data: one shared library, scanned by the server. Per-user
// tables (users, credentials, playlists, playback state, ...) arrive with auth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// No FK relations from the per-file tables below on purpose: @bpmix/core's
/// scanners may write metadata/lyrics for a fileId before (or after) its track
/// row exists, and orphans are cleaned by pruneOrphanedRootData instead.
/// Mirrors @bpmix/core's TrackRecord. fileId is `${rootId}:${relativePath}`
/// (or a synthetic id for `missing` placeholders).
model Track {
  fileId         String  @id @map("file_id")
  rootId         String  @map("root_id")
  relativePath   String  @map("relative_path")
  sizeBytes      BigInt  @map("size_bytes")
  lastModifiedMs Float   @map("last_modified_ms")
  missing        Boolean @default(false)

  @@index([rootId])
  @@map("tracks")
}

/// Mirrors PlaylistRecord. trackFileIds keeps the m3u8's order (duplicates allowed).
model Playlist {
  id           String   @id
  rootId       String   @map("root_id")
  fileId       String   @map("file_id")
  name         String
  trackFileIds String[] @map("track_file_ids")

  @@index([rootId])
  @@map("playlists")
}

model TrackMetadata {
  fileId          String   @id @map("file_id")
  title           String?
  artists         String[]
  album           String?
  durationSeconds Float?   @map("duration_seconds")
  sizeBytes       BigInt   @map("size_bytes")
  lastModifiedMs  Float    @map("last_modified_ms")
  parserVersion   Int      @map("parser_version")
  contentHash     String?  @map("content_hash")

  @@map("track_metadata")
}

model TrackAnalysis {
  fileId            String @id @map("file_id")
  normalizationGain Float  @map("normalization_gain")
  analyzedAtMs      Float  @map("analyzed_at_ms")
  sizeBytes         BigInt @map("size_bytes")
  lastModifiedMs    Float  @map("last_modified_ms")
  algorithmVersion  Int    @map("algorithm_version")

  @@map("track_analysis")
}

model CoverArt {
  fileId   String @id @map("file_id")
  mimeType String @map("mime_type")
  data     Bytes

  @@map("cover_art")
}

model LyricsScope {
  rootId       String @map("root_id")
  relativePath String @map("relative_path")

  @@id([rootId, relativePath])
  @@map("lyrics_scopes")
}

model LyricsAssignment {
  fileId    String  @id @map("file_id")
  lrcFileId String? @map("lrc_file_id")

  @@map("lyrics_assignments")
}

/// Server-level key/value fallback (the scanner never touches per-user state).
model KeyValue {
  key   String @id
  value String

  @@map("kv")
}

// ---------------------------------------------------------------------------
// Auth. Secrets (session/device tokens, invite tokens, device codes, recovery
// codes) are only ever stored as hashes; the plaintext is shown once.
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(uuid())
  /// Lower-cased; the login handle.
  username      String    @unique
  displayName   String    @map("display_name")
  role          Role      @default(USER)
  /// argon2id. A password alone never signs in: it also needs TOTP (see AuthService).
  passwordHash  String?   @map("password_hash")
  /// AES-256-GCM sealed with the server secret key.
  totpSecretEnc String?   @map("totp_secret_enc")
  totpEnabledAt DateTime? @map("totp_enabled_at")
  /// Last accepted TOTP time step, so a code can't be replayed inside its window.
  totpLastStep  Int?      @map("totp_last_step")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  credentials   Credential[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  deviceTokens  DeviceToken[]
  invites       Invite[]

  @@map("users")
}

/// A WebAuthn passkey.
model Credential {
  /// base64url credential id.
  id         String    @id
  userId     String    @map("user_id")
  publicKey  Bytes     @map("public_key")
  counter    BigInt
  transports String[]
  deviceType String    @map("device_type")
  backedUp   Boolean   @map("backed_up")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Browser sessions. id is the sha256 of the cookie value.
model Session {
  id         String   @id
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Long-lived, revocable per-device bearer tokens for the native apps (sync, streaming).
model DeviceToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// One-time enrollment link for an existing user: an admin creates the user, then hands them this
/// link to register their first passkey (or a replacement, as a credential reset). There is no open
/// registration - the only way to get an account is the very first sign-up, or one of these.
model Invite {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  createdById String?   @map("created_by_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invites")
}

/// Short-lived WebAuthn challenges and half-finished (password-passed, TOTP-pending) logins.
model AuthChallenge {
  id        String   @id
  purpose   String
  challenge String?
  userId    String?  @map("user_id")
  data      Json?
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("auth_challenges")
}

/// RFC 8628-style device authorization: a native app shows userCode, the user approves it in a signed-in browser.
model DeviceGrant {
  id             String   @id @default(uuid())
  deviceCodeHash String   @unique @map("device_code_hash")
  userCode       String   @unique @map("user_code")
  deviceName     String   @map("device_name")
  /// pending | approved | denied | claimed
  status         String   @default("pending")
  userId         String?  @map("user_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("device_grants")
}

// ---------------------------------------------------------------------------
// Scan job queue: one row per track, so a song is only ever queued once and
// only ever handed to one worker at a time. Workers claim rows with
// FOR UPDATE SKIP LOCKED and a lease, which also lets another worker (or
// server instance) take over a job whose worker died.
// ---------------------------------------------------------------------------

enum JobState {
  PENDING
  RUNNING
  DONE
  /// Failed every attempt. Left alone by later scans until the file or the
  /// parser/algorithm versions change, or an admin retries it.
  SKIPPED
}

model TrackJob {
  fileId         String    @id @map("file_id")
  state          JobState  @default(PENDING)
  /// size:mtime:parserVersion:algorithmVersion - a change resets the job.
  fingerprint    String
  attempts       Int       @default(0)
  /// Backoff: PENDING jobs are not claimable before this.
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedBy       String?   @map("locked_by")
  lockExpiresAt  DateTime? @map("lock_expires_at")
  /// Stages that already succeeded, so a retry doesn't redo them.
  metadataDone   Boolean   @default(false) @map("metadata_done")
  analysisDone   Boolean   @default(false) @map("analysis_done")
  lastError      String?   @map("last_error")
  lastErrorStage String?   @map("last_error_stage")
  skippedAt      DateTime? @map("skipped_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([state, runAfter])
  @@map("track_jobs")
}

/// Every failed attempt, kept for a while so it's possible to see what is failing and why.
model TrackJobFailure {
  id        Int      @id @default(autoincrement())
  fileId    String   @map("file_id")
  stage     String
  attempt   Int
  error     String
  willRetry Boolean  @map("will_retry")
  workerId  String   @map("worker_id")
  at        DateTime @default(now())

  @@index([fileId])
  @@index([at])
  @@map("track_job_failures")
}
