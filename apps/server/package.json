{
  "name": "@bpmix/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@bpmix/api": "workspace:*",
    "@bpmix/core": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "qrcode-generator": "1.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
