<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Replaces the Storage Access Framework tree-picker flow entirely -
         see BPMixFileAccessModule.kt's header comment for why (a broken
         Samsung "My Files" SAF picker made requesting a new folder grant
         unreliable). tools:ignore="ScopedStorage" - Google Play policy
         restricts this permission to apps whose core function is file
         management, but BPMix is sideloaded, never distributed through
         Play, so that policy doesn't apply here. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Lock-screen/notification-shade playback controls (MediaSession),
         backed by react-native-audio-api's PlaybackNotificationManager -
         see apps/mobile/src/adapters/mediaSessionNotification.ts. The
         library's own AndroidManifest.xml (checked in node_modules)
         declares neither of these - its Expo config plugin would inject
         them automatically, but BPMix is a bare RN app, so they're added
         by hand here instead. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Runtime-requested on API 33+ (see MediaSessionManager.kt's own
         checkSelfPermission/requestPermissions calls - no JS-side request
         flow needed for that part), but the manifest declaration itself is
         still required regardless of API level. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app "download release APK from GitHub + install it" update flow
         (tf.went.bpmix.appupdate.AppUpdateModule) - sideloaded apps have no
         Play Store to hand this off to. REQUEST_INSTALL_PACKAGES is the
         API 26+ per-app "install unknown apps" grant (checked/requested via
         PackageManager.canRequestPackageInstalls() at runtime, same as any
         other special-access permission - the manifest entry alone doesn't
         grant it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Backs the "bpmix://library" / "bpmix://now-playing" launcher
             shortcuts declared in res/xml/shortcuts.xml - routed to a
             screen from JS via App.tsx's applyDeepLink (Linking module).
             singleTask above means a tap while the app is already running
             reuses this same Activity instead of creating a second one -
             MainActivity.onNewIntent forwards that case to Linking's own
             'url' event. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bpmix" />
        </intent-filter>
        <!-- Android App Link for the Last.fm auth callback
             (useLastFmConnection.ts) - verified via
             /.well-known/assetlinks.json served from bpmix.went.tf
             (apps/web/public/.well-known/assetlinks.json), so Last.fm's
             redirect after approval opens straight back into BPMix instead
             of the browser, with no "which app?" prompt (autoVerify proves
             ownership). Scoped to exactly /lastfm-callback.html, not the
             bare host - unlike the bpmix:// scheme above (which only this
             app ever claims), matching the whole bpmix.went.tf host here
             would hijack ordinary links to the live web app itself into
             opening this native app instead of a browser, which is never
             what's wanted for a normal link to the site. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="bpmix.went.tf" android:path="/lastfm-callback.html" />
        </intent-filter>
        <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      </activity>
      <!-- The library starts/stops this itself (ForegroundServiceManager,
           driven from JS via PlaybackNotificationManager.show()/hide()) -
           it just needs to exist in the manifest for Android to allow
           starting it at all. foregroundServiceType must match one of
           androidFSTypes in the library's own config-plugin default
           ('mediaPlayback') to satisfy Android 14+'s foreground-service
           type enforcement. -->
      <service
        android:name="com.swmansion.audioapi.system.CentralizedForegroundService"
        android:exported="false"
        android:stopWithTask="true"
        android:foregroundServiceType="mediaPlayback" />
      <!-- Grants the system package installer a content:// URI for a
           downloaded update APK (AppUpdateModule.installApk) - required on
           API 24+ regardless of MANAGE_EXTERNAL_STORAGE, which only covers
           this app's own file access, not exposing a file:// path to
           another app (FileUriExposedException). Scoped to the one
           subdirectory AppUpdateModule actually downloads into - see
           file_paths.xml. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
